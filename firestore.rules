rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Strict Single-Guardian check: only the verified guardian registered on the ward's policy document
    function isGuardianOf(wardUid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/policies/$(wardUid)) &&
        get(/databases/$(database)/documents/policies/$(wardUid)).data.get('guardianUid', null) == request.auth.uid;
    }

    // 1. Pairings: Exchange and resolve 6-character alphanumeric pairing codes
    match /pairings/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (request.resource.data.status == 'LOCKED' && request.resource.data.pairedGuardianUid == request.auth.uid)
      );
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isGuardianOf(resource.data.ownerUid));
    }

    // 2. Policies: Unified protection policies with strict single-guardian lock
    match /policies/{wardUid} {
      allow read: if request.auth != null && (request.auth.uid == wardUid || isGuardianOf(wardUid));
      allow create: if request.auth != null && (request.auth.uid == wardUid || request.resource.data.get('guardianUid', null) == request.auth.uid);
      allow update: if request.auth != null && (
        // Case 1: Currently supervised -> ONLY the registered guardian can update or revoke
        (resource.data.get('guardianUid', null) != null && resource.data.get('guardianUid', null) == request.auth.uid) ||
        // Case 2: Currently unsupervised -> Ward can update standalone, OR new guardian can claim guardianship
        (resource.data.get('guardianUid', null) == null && (
          (request.auth.uid == wardUid && request.resource.data.get('guardianUid', null) == null) ||
          (request.resource.data.get('guardianUid', null) == request.auth.uid)
        ))
      );
      allow delete: if false;
    }

    // 3. Approvals: Zero-trust app installation requests and guardian approvals
    match /approvals/{ticketId} {
      allow read: if request.auth != null && (resource.data.wardUid == request.auth.uid || isGuardianOf(resource.data.wardUid));
      allow create: if request.auth != null && request.resource.data.wardUid == request.auth.uid && request.resource.data.status == 'PENDING';
      allow update: if request.auth != null && request.auth.uid != resource.data.wardUid && isGuardianOf(resource.data.wardUid);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.wardUid || isGuardianOf(resource.data.wardUid));
    }

    // 4. Users: Tokens and partner relationships
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
