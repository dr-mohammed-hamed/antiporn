rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to verify if the caller is the legitimate owner
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Strict Single-Guardian check: only the verified guardian registered on the ward's policy document
    function isGuardianOf(wardUid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/policies/$(wardUid)) &&
        get(/databases/$(database)/documents/policies/$(wardUid)).data.get('guardianUid', null) == request.auth.uid;
    }

    // 1. Pairings: Exchange and resolve 6-character alphanumeric pairing codes
    match /pairings/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (request.resource.data.status == 'LOCKED' && request.resource.data.pairedGuardianUid == request.auth.uid)
      );
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isGuardianOf(resource.data.ownerUid));
    }

    // 2. Policies: Unified protection policies with strict single-guardian lock, heartbeat & 24h emergency breakout
    match /policies/{wardUid} {
      allow read: if isOwner(wardUid) || isGuardianOf(wardUid);
      allow create: if isOwner(wardUid) || (request.auth != null && request.resource.data.get('guardianUid', null) == request.auth.uid);
      allow update: if request.auth != null && (
        // Case 1: Guardian updates or revokes
        (resource.data.get('guardianUid', null) != null && resource.data.get('guardianUid', null) == request.auth.uid) ||
        // Case 2: Currently unsupervised -> Ward updates standalone OR new guardian claims guardianship
        (resource.data.get('guardianUid', null) == null && (
          (isOwner(wardUid) && request.resource.data.get('guardianUid', null) == null) ||
          (request.resource.data.get('guardianUid', null) == request.auth.uid)
        )) ||
        // Case 3: Ward updates heartbeat while supervised
        (resource.data.get('guardianUid', null) != null && isOwner(wardUid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHeartbeat'])) ||
        // Case 4: Ward initiates or cancels 24h emergency breakout while supervised (protection stays intact)
        (resource.data.get('guardianUid', null) != null && isOwner(wardUid) &&
          request.resource.data.get('guardianUid', null) == resource.data.get('guardianUid', null) &&
          request.resource.data.get('isSupervised', null) == resource.data.get('isSupervised', null) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['breakoutStatus', 'breakoutRequestedAt', 'breakoutUnlockAt', 'updatedAt']) &&
          (
            // Subcase 4a: Initiating breakout -> Must enforce minimum 24 hours (with 15-minute clock drift tolerance)
            (request.resource.data.get('breakoutStatus', null) == 'PENDING' &&
             request.resource.data.get('breakoutUnlockAt', 0) >= request.time.toMillis() + 85500000 &&
             request.resource.data.get('breakoutRequestedAt', 0) <= request.time.toMillis() + 900000) ||
            // Subcase 4b: Cancelling breakout
            (request.resource.data.get('breakoutStatus', null) == 'CANCELLED' &&
             request.resource.data.get('breakoutUnlockAt', null) == null)
          )
        ) ||
        // Case 5: Ward executes emergency breakout AFTER 24h grace period has legitimately passed on server clock
        (resource.data.get('guardianUid', null) != null && isOwner(wardUid) &&
          resource.data.get('breakoutStatus', null) == 'PENDING' &&
          resource.data.get('breakoutUnlockAt', 0) > 0 &&
          request.time.toMillis() >= resource.data.get('breakoutUnlockAt', 0) &&
          request.resource.data.get('guardianUid', null) == null &&
          request.resource.data.get('isSupervised', false) == false &&
          request.resource.data.get('breakoutStatus', null) == 'COMPLETED')
      );
      allow delete: if false;
    }

    // 3. Approvals: Zero-trust app installation requests and guardian approvals as subcollection under policies
    match /policies/{wardUid}/approvals/{ticketId} {
      allow read: if request.auth != null && (request.auth.uid == wardUid || isGuardianOf(wardUid));
      allow create: if request.auth != null && request.auth.uid == wardUid && request.resource.data.status == 'PENDING';
      allow update: if request.auth != null && isGuardianOf(wardUid);
      allow delete: if request.auth != null && (request.auth.uid == wardUid || isGuardianOf(wardUid));
    }

    // Legacy Approvals: Root approvals collection kept for backward compatibility
    match /approvals/{ticketId} {
      allow read: if request.auth != null && (resource.data.wardUid == request.auth.uid || isGuardianOf(resource.data.wardUid));
      allow create: if request.auth != null && request.resource.data.wardUid == request.auth.uid && request.resource.data.status == 'PENDING';
      allow update: if request.auth != null && request.auth.uid != resource.data.wardUid && isGuardianOf(resource.data.wardUid);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.wardUid || isGuardianOf(resource.data.wardUid));
    }

    // 4. Users: Tokens and partner relationships
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 5. Inventories: App inventory uploaded by ward and inspected/managed by guardian
    match /inventories/{wardUid} {
      allow read: if request.auth != null && (request.auth.uid == wardUid || isGuardianOf(wardUid));
      allow create, update: if request.auth != null && request.auth.uid == wardUid;
      allow delete: if false;
    }
  }
}

