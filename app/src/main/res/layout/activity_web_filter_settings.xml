<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRootWebFilterSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarWebFilter"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/btn_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/web_filter_title"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Card 1: Encrypted DNS Host -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/tajawal"
                        android:text="@string/dns_host_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/tajawal"
                        android:text="@string/dns_table_title"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <!-- DNS Comparison Table -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Header Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="32dp"
                                android:background="?attr/colorSurfaceContainerHigh"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="3.4"
                                    android:fontFamily="@font/tajawal"
                                    android:text="@string/dns_col_server"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.3"
                                    android:gravity="center"
                                    android:fontFamily="@font/tajawal"
                                    android:text="@string/dns_col_porn"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.3"
                                    android:gravity="center"
                                    android:fontFamily="@font/tajawal"
                                    android:text="@string/dns_col_ads"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.4"
                                    android:gravity="center"
                                    android:fontFamily="@font/tajawal"
                                    android:text="@string/dns_col_youtube"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.6"
                                    android:gravity="center"
                                    android:fontFamily="@font/tajawal"
                                    android:text="@string/dns_col_speed"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Row 1: Cloudflare Family (Default) -->
                            <LinearLayout
                                android:id="@+id/rowDnsCloudflare"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="6dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="3.4"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/rbDnsCloudflare"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:clickable="false"
                                        android:focusable="false"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/tajawal"
                                        android:text="@string/dns_preset_cloudflare_title"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="16dp"
                                    android:layout_weight="1.3"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check_small"
                                    app:tint="@color/status_green"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="16dp"
                                    android:layout_weight="1.3"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_close"
                                    app:tint="?attr/colorOnSurfaceVariant"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="16dp"
                                    android:layout_weight="1.4"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check_small"
                                    app:tint="@color/status_green"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.6"
                                    android:gravity="center"
                                    android:fontFamily="@font/tajawal"
                                    android:text="@string/dns_speed_fast"
                                    android:textColor="@color/status_green"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Row 2: Control D (Light) -->
                            <LinearLayout
                                android:id="@+id/rowDnsControlD"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="6dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="3.4"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/rbDnsControlD"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:clickable="false"
                                        android:focusable="false"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/tajawal"
                                        android:text="@string/dns_preset_controld_title"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="16dp"
                                    android:layout_weight="1.3"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check_small"
                                    app:tint="@color/status_green"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="16dp"
                                    android:layout_weight="1.3"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check_small"
                                    app:tint="@color/status_green"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="16dp"
                                    android:layout_weight="1.4"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check_small"
                                    app:tint="@color/status_green"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.6"
                                    android:gravity="center"
                                    android:fontFamily="@font/tajawal"
                                    android:text="@string/dns_speed_warn"
                                    android:textColor="@color/status_orange"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Row 3: AdGuard Family -->
                            <LinearLayout
                                android:id="@+id/rowDnsAdguard"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="6dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="3.4"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/rbDnsAdguard"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:clickable="false"
                                        android:focusable="false"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/tajawal"
                                        android:text="@string/dns_preset_adguard_title"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="16dp"
                                    android:layout_weight="1.3"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check_small"
                                    app:tint="@color/status_green"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="16dp"
                                    android:layout_weight="1.3"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check_small"
                                    app:tint="@color/status_green"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="16dp"
                                    android:layout_weight="1.4"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_close"
                                    app:tint="?attr/colorOnSurfaceVariant"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.6"
                                    android:gravity="center"
                                    android:fontFamily="@font/tajawal"
                                    android:text="@string/dns_speed_medium"
                                    android:textColor="@color/status_orange"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Manual Custom DNS input below table -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/tajawal"
                        android:text="@string/dns_manual_input_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDnsHost"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDnsHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:hint="@string/guardian_dns_hint"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Security Switches (Incognito, VPN, Telegram Web) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp">

                    <!-- Switch 1: Block Incognito -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/tajawal"
                            android:text="@string/switch_block_incognito"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchBlockIncognito"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Switch 2: Block Telegram Web -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/tajawal"
                            android:text="@string/switch_block_telegram_web"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchBlockTelegramWeb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Switch 3: YouTube Restricted Mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/tajawal"
                            android:text="@string/switch_youtube_restricted"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchYouTubeRestricted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Switch 4: Full System Filtering (VPN) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/tajawal"
                            android:text="@string/switch_full_system_filter"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFullSystemFilter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Custom Blocked & Allowed Websites -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/tajawal"
                            android:text="@string/blocked_urls_section_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddBlockedUrl"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="0dp"
                            android:text="@string/btn_add_blocked_url"
                            android:textSize="12sp"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_edit"
                            app:iconSize="14dp" />
                    </LinearLayout>

                    <!-- Segmented Toggle Group -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleGroupUrlType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTabBlocked"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/tajawal"
                            android:paddingVertical="0dp"
                            android:text="@string/tab_blocked_websites"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTabAllowed"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/tajawal"
                            android:paddingVertical="0dp"
                            android:text="@string/tab_allowed_websites"
                            android:textSize="12sp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Whitelist Only Switch (Shown when Allowed Tab is selected) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutWhitelistOnlyMaster"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/tajawal"
                                android:text="@string/switch_whitelist_only"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchWhitelistOnly"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvEmptyBlockedUrls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/empty_blocked_urls"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutBlockedUrlsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Save Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomBarWebFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

