{
  "include": [
    "app/src/main/java/**/*.kt",
    "app/src/main/AndroidManifest.xml",
    "app/build.gradle.kts",
    "build.gradle.kts",
    "settings.gradle.kts"
  ],
  "output": {
    "filePath": "repomix-output-functional.xml",
    "style": "xml",
    "removeComments": true,
    "removeEmptyLines": true,
    "fileSummary": false,
    "directoryStructure": false
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/*.png",
      "**/*.webp",
      "**/*.jpg",
      "**/*.svg",
      "app/src/androidTest/**",
      "app/src/test/**",
      "app/src/main/res/**",
      ".agents/**",
      ".specify/**",
      "repomix-output*",
      "*.md",
      "local.properties",
      "key.properties"
    ]
  }
}
